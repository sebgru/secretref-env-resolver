# Example .env file for secretref-env-resolver
# Copy to a secure location and edit with your actual secrets.
#
# Mount this file at /run/secrets/.env inside the container:
#   volumes:
#     - ./my-secrets.env:/run/secrets/.env:ro

# Database credentials
DB_HOST=localhost
DB_PORT=5432
DB_USER=myuser
DB_PASSWORD=mysecretpassword

# API tokens
#GITHUB_TOKEN=ghp_xxxxxxxxxxxx
#OPENAI_API_KEY=sk-xxxxxxxxxxxx
#HOME_ASSISTANT_TOKEN=xxxxxxxxxxxx

# Service URLs
#SOME_SERVICE_URL=https://example.com/api
