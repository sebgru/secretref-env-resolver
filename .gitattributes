# Ensure consistent LF line endings for all text files.
* text=auto eol=lf

# Python
*.py    text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.env   text eol=lf

# Docker
Dockerfile      text eol=lf
.dockerignore   text eol=lf

# Explicitly binary
*.png    binary
*.jpg    binary
*.gif    binary
*.ico    binary
